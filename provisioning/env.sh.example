# Copy to /home/isucon/env.sh on the app server (or merge into existing env.sh).
# Official AMI defaults to TCP loopback; for same-host MySQL, unix socket avoids TCP overhead.

# --- MySQL (Go app reads all of these via connectDB in go/main.go) ---
ISUCON13_MYSQL_DIALCONFIG_NET="unix"
ISUCON13_MYSQL_DIALCONFIG_ADDRESS="/var/run/mysqld/mysqld.sock"
# PORT is ignored when NET=unix
ISUCON13_MYSQL_DIALCONFIG_PORT="3306"
ISUCON13_MYSQL_DIALCONFIG_USER="isucon"
ISUCON13_MYSQL_DIALCONFIG_PASSWORD="isucon"
ISUCON13_MYSQL_DIALCONFIG_DATABASE="isupipe"
ISUCON13_MYSQL_DIALCONFIG_PARSETIME="true"

# --- TCP fallback (stock ISUCON13 AMI) ---
# ISUCON13_MYSQL_DIALCONFIG_NET="tcp"
# ISUCON13_MYSQL_DIALCONFIG_ADDRESS="127.0.0.1"
# ISUCON13_MYSQL_DIALCONFIG_PORT="3306"

ISUCON13_POWERDNS_SUBDOMAIN_ADDRESS="127.0.0.1"
ISUCON13_POWERDNS_DISABLED="false"

# App gzip is opt-in; stock nginx does not gzip API responses (see provisioning/nginx/isupipe.conf).
# ISUCON13_GZIP="1"
